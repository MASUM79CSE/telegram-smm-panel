# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; .env.example is a template with
# placeholder values only and is deliberately allow-listed below.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI coding-assistant tooling (ECC / "Everything Claude Code", Claude Code
# agents/skills/commands, and any similar per-project AI dev tooling) is
# intentionally NOT part of this repo. It has no effect on the built/deployed
# app (it was already excluded from tsconfig.json and next.config.ts's file
# tracing even when present) and isn't something a contributor or production
# audit should have to wade through. Keep it out entirely — do not vendor
# .claude/, .agents/, .ecc-vendor/, CLAUDE.md, AGENTS.md, or skills-lock.json
# back into version control.
.claude/
.agents/
.ecc-vendor/
CLAUDE.md
AGENTS.md
skills-lock.json

# Playwright e2e test artifacts (npm run test:e2e) — HTML report,
# traces/screenshots on failure, and the downloaded browser binaries
# themselves (installed separately via `npx playwright install`, not
# vendored into this repo).
/test-results/
/playwright-report/
/playwright/.cache/

# Internal working notes — never meant for the public repo (see README.md's
# own note on this)
MEMORY.md

# Prisma generated client (generated code, not source)
/lib/generated/prisma
