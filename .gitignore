# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; .env.example is a template with
# placeholder values only and is deliberately allow-listed below.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ECC (Everything Claude Code) — vendored via the official installer.
# .claude/ itself (agents/skills/commands/rules/hooks/settings.json) IS
# meant to be committed — that's what makes the Claude Code plugin
# "vendored per-project" rather than a local-machine-only install, so
# every contributor who clones this repo gets it automatically. Only its
# install-state noise is excluded (regenerated by the installer, and
# contains this machine's absolute path).
.claude/ecc/install-state.json

# .ecc-vendor/ is a full pristine copy of the upstream ECC repo
# (github.com/affaan-m/ECC), kept ONLY so its installer scripts
# (doctor.js/list-installed.js/install-apply.js — see docs/ECC_SETUP.md)
# can be re-run locally without a fresh clone. At ~58MB of third-party
# tooling/docs/tests that this project doesn't otherwise use, committing
# it would permanently bloat this repo's git history for something fully
# regenerable on demand. Re-create it with:
#   git clone --depth 1 https://github.com/affaan-m/ECC .ecc-vendor
#   cd .ecc-vendor && npm install --omit=dev
.ecc-vendor/

# Playwright e2e test artifacts (npm run test:e2e) — HTML report,
# traces/screenshots on failure, and the downloaded browser binaries
# themselves (installed separately via `npx playwright install`, not
# vendored into this repo).
/test-results/
/playwright-report/
/playwright/.cache/

# Internal working notes — never meant for the public repo (see README.md's
# own note on this)
MEMORY.md
