{
  "name": "telegram-smm-panel",
  "version": "0.1.0",
  "private": true,
  "description": "A production-oriented, multi-platform SMM (Social Media Marketing) panel built with Next.js \u2014 web dashboard + Telegram bot on one shared backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MASUM79CSE/telegram-smm-panel.git"
  },
  "author": "Mir Md. Masum",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "backfill-service-providers": "tsx scripts/backfill-service-providers.ts",
    "process-orders": "tsx scripts/process-orders.ts",
    "poll-order-status": "tsx scripts/poll-order-status.ts",
    "compute-delivery-estimates": "tsx scripts/compute-delivery-estimates.ts",
    "telegram:webhook": "tsx scripts/setup-telegram-webhook.ts",
    "telegram:poll": "tsx scripts/run-bot-polling.ts",
    "verify-restore": "tsx scripts/verify-restore.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/storage-mongodb": "^2.6.0",
    "@sentry/nextjs": "^10.74.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.46.0",
    "lucide-react": "^1.38.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.4",
    "nanoid": "^5.1.16",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.2",
    "nodemailer": "^9.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "nodemailer": "^9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
