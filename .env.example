# ==============================================================================
# SMM Panel — Environment Configuration
# Copy this file to .env.local for development or .env for production
# NEVER commit real secrets to version control
# ==============================================================================

# --- Database (MongoDB Atlas) ---------------------------------------------
# Get this from MongoDB Atlas: Database > Connect > Drivers
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/telegram_panel?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/telegram_panel?retryWrites=true&w=majority"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_long_random_secret_min_32_chars"
NEXTAUTH_URL="http://localhost:3000"
# REQUIRED in production: Auth.js only trusts the request's Host header
# automatically when NODE_ENV is NOT "production" (always true in local dev,
# which is why this is easy to miss until deploying). NEXTAUTH_URL alone
# does NOT satisfy this — it only overrides the request URL, it does not set
# trustHost. Set AUTH_TRUST_HOST=true below (fine if you're behind a reverse
# proxy/load balancer that already validates the Host header, which is the
# common case) or set AUTH_URL (not NEXTAUTH_URL) to your canonical domain.
AUTH_TRUST_HOST="true"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Email (transactional: verification, password reset, notifications) ----
# Any SMTP provider works (e.g. Resend SMTP, SendGrid, Mailgun, Gmail app password)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="replace_me"
EMAIL_FROM="Telegram Panel <no-reply@yourdomain.com>"

# --- Rate limiting (Upstash Redis - free tier available) -------------------
# If left blank, the app falls back to an in-memory limiter (single instance only,
# NOT safe for multi-instance/production deployments — set these for prod).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Telegram Bot (optional — enables admin notifications, account linking, ---
# --- and the full ordering/deposit/support bot when TELEGRAM_BOT_TOKEN is set) -
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""
# Your personal/admin numeric chat id (message @userinfobot to find it) — the
# bot sends new-order/new-deposit/new-ticket alerts here.
TELEGRAM_ADMIN_CHAT_ID=""
# Shared secret Telegram must echo back on webhook requests
# (X-Telegram-Bot-Api-Secret-Token header). Required in production when using
# webhook mode; without it anyone who discovers your webhook URL could POST
# forged updates to it. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Public bot username without the "@", e.g. "MyPanelBot" — used to render the
# t.me deep link on the dashboard's Telegram-linking page.
TELEGRAM_BOT_USERNAME=""

# --- Security ----------------------------------------------------------------
# Comma-separated list of extra allowed origins for CORS on public API endpoints.
# Supports the same wildcard syntax as Next.js's `allowedDevOrigins`
# (next.config.ts): a bare hostname for an exact match, "*.foo" for exactly
# one subdomain label, "**.foo" for one-or-more labels. If you run this app
# behind a sandboxed/tunneled preview domain (e.g. Arena Agent Mode / E2B,
# which serves the app from a dynamic "<port>-<sandboxId>.e2b.app" host
# instead of localhost), add that domain here — otherwise every API call
# from the browser gets a silent 403 and forms will appear to do nothing.
ALLOWED_ORIGINS="http://localhost:3000,**.e2b.app"

# --- Seed (used only by scripts/seed.ts) ------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Background jobs / cron (serverless deployments, e.g. Vercel) ----------
# Shared secret required by GET /api/cron/process-orders, /poll-order-status,
# and /compute-delivery-estimates (checked with a constant-time comparison —
# see lib/security/cron-auth.ts). Without it these routes return 503 and
# refuse to run. Must match the CRON_SECRET repository secret used by
# .github/workflows/cron.yml (the external scheduler that calls them —
# see README.md §11 and docs/PRODUCTION_READINESS.md §14 for why GitHub
# Actions is used instead of Vercel's own Cron Jobs). Generate with:
# openssl rand -hex 32
# Not needed at all if you run the background workers as long-lived
# processes instead (npm run process-orders -- --loop, etc.) — see README.md.
CRON_SECRET=""

# --- Error tracking & performance monitoring (Sentry, optional) ------------
# Create a free project at https://sentry.io. Every Sentry call in this app
# safely no-ops until SENTRY_DSN is set, so it's fine to deploy without this
# first and add it later. SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN should be the
# SAME value: the server/edge SDK reads SENTRY_DSN, the browser bundle needs
# the NEXT_PUBLIC_-prefixed copy to access it client-side.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to enable source-map upload at build time (readable, non-
# minified stack traces in the Sentry UI). Safe to leave blank — the build
# just skips this step. Get these from Sentry: Settings > Auth Tokens, and
# your org/project slugs from the project URL.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
